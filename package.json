{
  "name": "governed-action-lab",
  "version": "1.2.1",
  "description": "A deterministic reference implementation for governing agent actions.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "governed-action-lab": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "build:clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build --silent && npm run test:built",
    "test:built": "node --test dist/test/*.test.js",
    "eval": "npm run build --silent && npm run eval:built",
    "eval:built": "node dist/src/eval-runner.js",
    "contract:check": "node scripts/check-context-contract.mjs",
    "fixture:fresh": "npm run build --silent && node scripts/freshen-public-fixture.mjs",
    "demo:attacks": "npm run build --silent && npm run demo:attacks:built",
    "demo:attacks:built": "node dist/src/attack-demo.js",
    "demo:sync": "node scripts/build-browser-runtime.mjs && node scripts/sync-demo.mjs",
    "demo:check": "node scripts/build-browser-runtime.mjs --check && node scripts/sync-demo.mjs --check",
    "proof:sync": "npm run build --silent && node scripts/build-portable-proof.mjs",
    "proof:check": "npm run build --silent && npm run proof:check:built",
    "proof:check:built": "node scripts/build-portable-proof.mjs --check",
    "qa:responsive": "node scripts/check-responsive.mjs",
    "public-safety:check": "node scripts/check-public-safety.mjs",
    "public-safety:install": "git config core.hooksPath .githooks",
    "check": "npm run public-safety:check && npm run contract:check && npm run build:clean && npm run test:built && npm run eval:built && npm run demo:attacks:built && npm run demo:check && npm run proof:check:built && npm run qa:responsive",
    "action": "npm run build --silent && node dist/src/cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
